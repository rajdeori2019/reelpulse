# Copy to .env and fill in. Every one of these is free.
# `reelpulse doctor` tells you exactly what each missing key costs you.

# --- The one that makes this an Instagram tool ------------------------------
# Free with any Instagram Business or Creator account (switch in the app).
# developers.facebook.com -> create app -> add "Instagram" product
# -> generate a long-lived access token (60 days, refreshable).
#
# This ONE credential unlocks all of:
#   * Hashtag Search      - other people's public reels by hashtag
#                           (30 unique hashtags per rolling 7 days)
#   * Business Discovery  - REAL view counts for a creator watchlist
#   * Your own insights   - views, reach, watch time on your reels
#   * Weight calibration  - fits the scoring model to your own results
IG_ACCESS_TOKEN=your_token_here
IG_USER_ID=your_ig_user_id_here

# --- View counts at global scale --------------------------------------------
# Instagram publishes no view count for reels outside your watchlist, so
# cross-posted YouTube Shorts supply that number instead.
# console.cloud.google.com -> new project -> enable "YouTube Data API v3"
# -> Credentials -> API key. Free tier: 10,000 units/day, no card required.
YOUTUBE_API_KEY=your_key_here

# --- Off-platform share signal ----------------------------------------------
# reddit.com/prefs/apps -> create app -> type "script". Free.
REDDIT_CLIENT_ID=your_client_id_here
REDDIT_CLIENT_SECRET=your_client_secret_here

# Not needed, listed for clarity:
#   Instagram oEmbed  - tokenless since Meta's 15 Jun 2026 change
#   Wikimedia Pageviews - no key, no quota
